<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="BasisColor">#FF008A00</Color>
  <Color x:Key="BasisschriftColor">#FFF5F5F5</Color>
  <Color x:Key="HighlightColor">#3c6eb0</Color>
  <Color x:Key="PressedColor">#3c6ecc</Color>
  <Color x:Key="DialogHintergrundColor">#FFFFFFFF</Color>
  <Color x:Key="DialogButtonsHintergrundColor">#FFDDDDDD</Color>
  <Color x:Key="DisabledBackgroundColor">#A5FFFFFF</Color>
  <Color x:Key="DisabledForegroundColor">#FF888888</Color>

  <SolidColorBrush x:Key="IconBrush" Color="Black"/>
  <SolidColorBrush x:Key="BasisBrush" Color="#FFbed0e8"/>
  <SolidColorBrush x:Key="BasisschriftBrush" Color="{StaticResource BasisschriftColor}"/>
  <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}"/>
  <SolidColorBrush x:Key="LogoschriftBrush" Color="#FFEEEEEE"/>
  <SolidColorBrush x:Key="DialogHintergrundBrush" Color="{StaticResource DialogHintergrundColor}"/>
  <SolidColorBrush x:Key="DialogButtonsHintergrundBrush" Color="{StaticResource DialogButtonsHintergrundColor}"/>

  <SolidColorBrush x:Key="HausaufgabeNichtGemachtBrush" Color="#99FF0000"/>
  <SolidColorBrush x:Key="HausaufgabeNachgereichtBrush" Color="#99FFA500"/>
  <LinearGradientBrush x:Key="HighlightGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#AA3c6eb0" />
    <GradientStop Offset="0.4" Color="#FF3c6eb0" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ReiheBackgroundBrush" Color="#996495ED"/>
  <SolidColorBrush x:Key="SequenzBackgroundBrush" Color="#99F0DDFF"/>
  <SolidColorBrush x:Key="FerienBackgroundBrush" Color="MediumAquamarine"/>
  <SolidColorBrush x:Key="StundeSourceBackgroundBrush" Color="#996422ED"/>
  <SolidColorBrush x:Key="StundeTargetBackgroundBrush" Color="#99009900"/>
  <SolidColorBrush x:Key="PhaseBackgroundBrush" Color="#99DDDDDD"/>
  <SolidColorBrush x:Key="MetroHeaderBackground" Color="SteelBlue"/>

  <SolidColorBrush x:Key="NotentendenzBrush" Color="#99999999"/>
  <SolidColorBrush x:Key="NotenBrush" Color="#99009900"/>
  <SolidColorBrush x:Key="StandBrush" Color="MediumAquamarine"/>
  <SolidColorBrush x:Key="NotentypBrush" Color="Thistle"/>
  <SolidColorBrush x:Key="GlyphBrush" Color="#FF567DB1" />
  <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}"/>
  <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}"/>

  <SolidColorBrush x:Key="SideButtonsExternalBorderBrush" Color="#FFB0CBEF"/>
  <SolidColorBrush x:Key="SideButtonsInternalBorderBrush" Color="#3c6eb0"/>

  <LinearGradientBrush x:Key="SideButtonsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#ffffff" Offset="0"></GradientStop>
    <GradientStop Color="#bed0e8" Offset="0.4"></GradientStop>
    <GradientStop Color="#FF7495C2" Offset="0.4"></GradientStop>
    <GradientStop Color="#ffffff" Offset="1"></GradientStop>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SideButtonsLightBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#ffffff" Offset="0"></GradientStop>
    <GradientStop Color="#FFFEAE62" Offset="0.4"></GradientStop>
    <GradientStop Color="#FFF6CF57" Offset="0.4"></GradientStop>
    <GradientStop Color="#ffffff" Offset="1"></GradientStop>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SideButtonsPlusLightBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#ffffff" Offset="0"></GradientStop>
    <GradientStop Color="#FFFD983F" Offset="0.4"></GradientStop>
    <GradientStop Color="#FFFEAE62" Offset="0.4"></GradientStop>
    <GradientStop Color="#ffffff" Offset="1"></GradientStop>
  </LinearGradientBrush>

</ResourceDictionary>